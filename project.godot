; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Astroventure"
run/main_scene="res://Scenes/Screens/main_menu.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
run/max_fps=60
config/icon="res://icon.svg"

[autoload]

Events="*res://Scenes/Singletons/Events.gd"
LevelTransition="*res://Scenes/Singletons/level_transition.tscn"
Globals="*res://Scenes/Singletons/Globals.gd"
Leaderboards="*res://addons/quiver_leaderboards/leaderboards.tscn"
PlayerAccounts="*res://addons/quiver_player_accounts/player_accounts.tscn"
Analytics="*res://addons/quiver_analytics/analytics.tscn"

[display]

window/size/viewport_width=360
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/quiver_analytics/plugin.cfg", "res://addons/quiver_leaderboards/plugin.cfg", "res://addons/quiver_player_accounts/plugin.cfg")

[gui]

theme/custom="res://Aesthethics/button.tres"
theme/custom_font="res://Aesthethics/pixel_font.ttf"
theme/default_font_subpixel_positioning=0

