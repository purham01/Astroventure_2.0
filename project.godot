; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[Fmod]

General/auto_initialize=true
General/channel_count=1024
General/is_live_update_enabled=true
General/is_memory_tracking_enabled=false
"Software Format/sample_rate"=48000
"Software Format/speaker_mode"=3
"Software Format/raw_speaker_count"=0
General/default_listener_count=1
General/banks_path="res://"
General/should_load_by_name=false
DSP/dsp_buffer_size=512
DSP/dsp_buffer_count=4
"3D Settings/doppler_scale"=1.0
"3D Settings/distance_factor"=1.0
"3D Settings/rolloff_scale"=1.0

[application]

config/name="Astroventure"
run/main_scene="uid://br2aite2suv0n"
config/features=PackedStringArray("4.4", "GL Compatibility")
run/max_fps=60
config/icon="res://icon.svg"

[autoload]

Events="*res://Scenes/Singletons/Events.gd"
LevelTransition="*res://Scenes/Singletons/level_transition.tscn"
Globals="*res://Scenes/Singletons/Globals.gd"
Leaderboards="*res://addons/quiver_leaderboards/leaderboards.tscn"
PlayerAccounts="*res://addons/quiver_player_accounts/player_accounts.tscn"
Analytics="*res://addons/quiver_analytics/analytics.tscn"
Console="*res://addons/console/console.gd"
FmodManager="*res://addons/fmod/FmodManager.gd"
FreezeFrameManager="*res://Scenes/Singletons/FreezeFrameManager.gd"
ConfigFileHandler="*res://Scenes/Singletons/ConfigFileHandler.gd"
GUI="*res://Scenes/Singletons/gui_autoload.gd"
ShaderEffect="*res://Scenes/Singletons/ShaderEffect/ShaderEffect.tscn"
Save="*res://Scenes/Singletons/Save.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/resizable=false
window/size/borderless=true
window/size/always_on_top=true
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/console/plugin.cfg", "res://addons/fmod/plugin.cfg", "res://addons/quiver_analytics/plugin.cfg", "res://addons/quiver_leaderboards/plugin.cfg", "res://addons/quiver_player_accounts/plugin.cfg")

[gui]

theme/custom="uid://dejvr5rqllmfx"
theme/custom_font="uid://c0v5xrpar3ub6"
theme/default_font_subpixel_positioning=0

