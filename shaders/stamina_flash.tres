code = "shader_type canvas_item;
render_mode blend_mix;

uniform bool BooleanParameter;
uniform vec4 ColorParameter : source_color = vec4(0.670588, 0.231373, 0.000000, 1.000000);



void fragment() {
// BooleanParameter:5
	bool n_out5p0 = BooleanParameter;


// ColorParameter:3
	vec4 n_out3p0 = ColorParameter;


// Input:6
	vec4 n_out6p0 = COLOR;


	vec3 n_out4p0;
// If:4
	float n_in4p1 = 1.00000;
	float n_in4p2 = 0.00001;
	if(abs((n_out5p0 ? 1.0 : 0.0) - n_in4p1) < n_in4p2)
	{
		n_out4p0 = vec3(n_out3p0.xyz);
	}
	else if((n_out5p0 ? 1.0 : 0.0) < n_in4p1)
	{
		n_out4p0 = vec3(n_out6p0.xyz);
	}
	else
	{
		n_out4p0 = vec3(n_out6p0.xyz);
	}


// Output:0
	COLOR.rgb = n_out4p0;


}
